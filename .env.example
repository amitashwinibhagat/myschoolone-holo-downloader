# H Company Models API key. Never commit the real key.
HAI_API_KEY=replace_me

# Exact MySchoolOne Pro URL used by your child's school.
SCHOOL_URL=https://replace-with-your-school-login-url.example

# H Company recommends this model for interactive computer-use loops.
HOLO_MODEL=holo3-1-35b-a3b

# Where downloaded images will be stored. ~ is supported.
DOWNLOAD_DIR=~/Pictures/School Updates

# Persistent browser profile and download history. Prefer paths outside iCloud
# Drive (e.g. ~/.local/share/...) so sessions and state are not synced between Macs.
BROWSER_PROFILE_DIR=~/.local/share/myschoolone-downloader/browser-profile
STATE_DIR=~/.local/share/myschoolone-downloader/state

# Which browser to drive. Leave blank to auto-detect a real installed browser
# (tries Google Chrome, then Microsoft Edge) which avoids Cloudflare "Verifying
# you are human" challenges. Set to "chrome" or "msedge" to force one, or
# "chromium" to force Playwright's bundled browser.
BROWSER_CHANNEL=

# Browser / agent behaviour.
HEADLESS=false
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=1000
MAX_STEPS=80
LOOKBACK_DAYS=7

# Safe for H Company's free-tier limit of 10 requests/minute. Set lower only if
# your account has a higher rate limit.
MIN_API_INTERVAL_MS=6500

# Ignore tiny icons, avatars and logos.
MIN_IMAGE_WIDTH=500
MIN_IMAGE_HEIGHT=350

# Telegram notifications (optional). When set, you'll get a message on success
# or failure even when you're not at the Mac. Leave blank to use macOS notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
