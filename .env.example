# H Company Models API key. Never commit the real key.
HAI_API_KEY=replace_me

# Exact MySchoolOne Pro URL used by your child's school.
SCHOOL_URL=https://replace-with-your-school-login-url.example

# H Company recommends this model for interactive computer-use loops.
HOLO_MODEL=holo3-1-35b-a3b

# Where downloaded images will be stored. ~ is supported. The Mac Mini is set
# to the iCloud Drive folder so photos also appear on the phone:
#   DOWNLOAD_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/School Updates
DOWNLOAD_DIR=~/Pictures/School Updates

# Persistent browser profile and download history. Prefer paths outside iCloud
# Drive (e.g. ~/.local/share/...) so sessions and state are not synced between Macs.
BROWSER_PROFILE_DIR=~/.local/share/myschoolone-downloader/browser-profile
STATE_DIR=~/.local/share/myschoolone-downloader/state

# Which browser to drive. Leave blank to auto-detect a real installed browser
# (tries Google Chrome, then Microsoft Edge) which avoids Cloudflare "Verifying
# you are human" challenges. Set to "chrome" or "msedge" to force one, or
# "chromium" to force Playwright's bundled browser.
BROWSER_CHANNEL=

# Browser / agent behaviour.
HEADLESS=false
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=1000
MAX_STEPS=80
LOOKBACK_DAYS=7

# Safe for H Company's free-tier limit of 10 requests/minute. Set lower only if
# your account has a higher rate limit.
MIN_API_INTERVAL_MS=6500

# Ignore tiny icons, avatars and logos.
MIN_IMAGE_WIDTH=500
MIN_IMAGE_HEIGHT=350

# Image compression (applied after duplicate detection, before writing to disk).
COMPRESS_IMAGES=true
# Longest edge in pixels; larger images are downscaled to fit inside.
MAX_DIMENSION=2048
# JPEG quality 1-100 for compressed output.
JPEG_QUALITY=82

# Telegram notifications and remote control (optional). When set, you'll get
# messages on success/failure and you can send /run, /status, /help to the bot
# from the configured chat. Leave blank to use macOS notifications only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Healthchecks.io (or compatible) ping URL. The scheduler pings it
# after the successful weekday 21:00 reconciliation, without sending school data.
HEALTHCHECK_URL=

# AI mode: "auto" (default) uses the Holo vision agent for complex portal
# navigation; "none" forces deterministic-only operation — no screenshots are
# sent to external APIs, useful for maximum privacy.
AI_MODE=auto

# Direct HTTP poll (no browser). Defaults to FALSE because the portal's AJAX
# endpoints sit behind a Cloudflare challenge that raw requests cannot pass —
# the failed POSTs add bot-score noise against the same IP right before the
# browser logs in. Set DIRECT_POLL=true only if the challenge is removed.
DIRECT_POLL=false

# OPTIONAL: portal credentials for fully automatic re-login. When the portal
# session expires (it does periodically), the downloader fills these in and
# signs back in by itself instead of waiting for you.
#   - They are stored in plaintext in .env — only use on a trusted machine.
#   - Leave empty to rely on `npm run login` (which auto-saves them for you the
#     first time you sign in manually).
# SCHOOL_USERNAME=
# SCHOOL_PASSWORD=
